# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Everything here is a placeholder; none of these are real credentials.
#
# Used by: `docker compose up` (compose.yaml reads .env automatically from the project root).

# ---------------------------------------------------------------------------
# Database (Docker Compose's own Postgres container — a separate instance from
# whatever Postgres you may already run locally for IntelliJ; see README).
# ---------------------------------------------------------------------------
DB_NAME=tunagiftset
DB_USERNAME=change_me
DB_PASSWORD=change_me

# Host-side port mappings. Defaults avoid clashing with a Postgres already running on the
# host at 5432. Change only if these also collide with something else on your machine.
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=8081

# ---------------------------------------------------------------------------
# Spring profile: "dev" for the local Docker stack, "prod" only with compose.prod.yaml
# and a real deployment target (see README — this step does not set one up).
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change_me
JWT_EXPIRES_IN_SECONDS=3600

# Kakao/Google social login. Leave empty to leave that login button hidden — it's not
# required for the rest of the app to work. Client IDs are also needed by the frontend
# build (VITE_*, below) since the browser starts the OAuth redirect itself; the *secret*
# values here are backend-only and must never be prefixed VITE_.
# Register both providers' redirect URI as: <site origin>/auth/kakao/callback (or google/callback)
KAKAO_CLIENT_ID=change_me
KAKAO_CLIENT_SECRET=change_me
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
VITE_KAKAO_CLIENT_ID=change_me
VITE_GOOGLE_CLIENT_ID=change_me

# Comma-separated. Must be set explicitly (no permissive default) once SPRING_PROFILES_ACTIVE=prod.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Toss Payments — TEST keys only. Never put a live secret key here.
# ---------------------------------------------------------------------------
TOSS_SECRET_KEY=change_me
# Public key, safe to expose in the browser bundle — but it's baked in at frontend BUILD
# time (Vite), so changing it requires `docker compose build frontend`, not just a restart.
VITE_TOSS_CLIENT_KEY=change_me

# ---------------------------------------------------------------------------
# Object storage. STORAGE_TYPE=local (default) needs no AWS values at all.
# Only fill in the rest if you switch STORAGE_TYPE=s3 against a real dev/test bucket.
# ---------------------------------------------------------------------------
STORAGE_TYPE=local
S3_BUCKET_NAME=change_me
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
