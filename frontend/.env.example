# Copy this file to .env.local for local overrides. Never put secret keys here —
# every VITE_* value is bundled into the browser JS and is publicly visible.

# Leave empty to use Vite's dev proxy (see vite.config.js) which forwards /api to
# the local Spring Boot server. Set an absolute URL only for pointing at a
# different backend (e.g. a deployed API).
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8090

# Toss Payments CLIENT key (safe to expose to the browser — this is NOT the secret
# key). The value below is Toss's own publicly published sandbox test client key,
# documented at https://docs.tosspayments.com for anyone to use in test mode.
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
